# Public regression scanner's machine-local private markers must never be staged.
.public-scan-private-markers
.env.*
!.env.example
venv/
*.py[cod]
*.log
*.tmp
.coverage
.mypy_cache/
.ruff_cache/
.env
*.token
*.key
*.pem
*.p12
__pycache__/
.venv/
out/
.lego/
.pytest_cache/
/build/
/dist/
*.egg-info/
