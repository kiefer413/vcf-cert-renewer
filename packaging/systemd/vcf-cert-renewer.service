[Unit]
Description=VCF public certificate renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/vcf-cert-renewer
EnvironmentFile=/etc/vcf-cert-renewer/vcf-cert-renewer.env
ExecStart=/usr/bin/python3 -m vcf_cert_renewer scheduled
Environment=VCF_LOG_FILE=/var/log/vcf-cert-renewer/renewer.log
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
