# Copy to .env; never commit secrets.
VCF_API_TOKEN=
# Use one dedicated non-interactive service-account identity for both auth families.
SDDC_URL=https://sddc.example.com
SDDC_USERNAME=svc-vcf-cert-renewer@example.com
SDDC_PASSWORD=
CSR_COUNTRY=US
CSR_STATE=California
CSR_LOCALITY=Los Angeles
CSR_ORGANIZATION=Example Organization
CSR_ORGANIZATION_UNIT=VCF
DNSUPDATE_TSIG_SECRET=

# Canonical VCF names. VCF_BASE_URL and VCF_TOKEN_URL are compatibility aliases.
VCF_URL=https://ops.example.com
VCF_TOKEN_ENDPOINT=https://vcenter.example.com/acs/t/CUSTOMER/token
VCF_VERIFY_TLS=true
VCF_TIMEOUT_SECONDS=30
NSX_URL=https://nsxt.vcf.example.com
NSX_VERIFY_TLS=true

# Safe default is staging. ACME_SERVER, when set, overrides ACME_MODE.
# Legacy selector: production/staging applies only when ACME_SERVER is empty.
ACME_MODE=staging
# Explicit directory overrides ACME_MODE. Leave empty to preserve the selector.
ACME_SERVER=
# Production example: https://acme-v02.api.letsencrypt.org/directory
# Custom example: https://acme.example.com/directory
# Optional EAB: configure BOTH values, or leave BOTH empty.
ACME_EAB_KID=
ACME_EAB_HMAC=
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=admin@example.com

DNS_PROVIDER=rfc2136
DNSUPDATE_NAMESERVER=192.0.2.53:53
DNSUPDATE_TSIG_KEY=vcf-acme-example.
# Public resolvers avoid split-DNS answers.
PUBLIC_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
DNSUPDATE_TSIG_ALGORITHM=hmac-sha256.
LEGO_PATH=/usr/local/bin/lego
OUTPUT_DIR=./out
RENEW_BEFORE_DAYS=30
VCF_RENEW_TARGETS=ops.vcf.example.com,sddc.vcf.example.com,vcenter.vcf.example.com,nsxt.vcf.example.com
