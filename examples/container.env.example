# Non-secret configuration only. Replace example endpoints for your deployment.
VCF_URL=https://ops.vcf.example.com
VCF_TOKEN_ENDPOINT=https://vcenter.vcf.example.com/acs/t/CUSTOMER/token
SDDC_URL=https://sddc.vcf.example.com
NSX_URL=https://nsxt.vcf.example.com
VCF_VERIFY_TLS=true
NSX_VERIFY_TLS=true
SDDC_USERNAME=administrator@example.com
ACME_EMAIL=admin@example.com
ACME_MODE=staging
DNSUPDATE_NAMESERVER=192.0.2.53:53
DNSUPDATE_TSIG_KEY=example-key
VCF_API_TOKEN_FILE=/run/secrets/vcf_api_token
SDDC_PASSWORD_FILE=/run/secrets/sddc_password
DNSUPDATE_TSIG_SECRET_FILE=/run/secrets/dns_tsig_secret
# Optional EAB; configure both parts together:
# ACME_EAB_KID=example-kid
# ACME_EAB_HMAC_FILE=/run/secrets/acme_eab_hmac
OUTPUT_DIR=/data
