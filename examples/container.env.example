# Non-secret configuration only. Replace example endpoints for your deployment.
VCF_URL=https://ops.vcf.example.com
VCF_TOKEN_ENDPOINT=https://vcenter.vcf.example.com/acs/t/CUSTOMER/token
SDDC_URL=https://sddc.vcf.example.com
NSX_URL=https://nsxt.vcf.example.com
VCF_VERIFY_TLS=true
NSX_VERIFY_TLS=true
SDDC_USERNAME=administrator@example.com
ACME_EMAIL=certificates@yourdomain.tld
ACME_MODE=staging
DNSUPDATE_NAMESERVER=192.0.2.53:53
DNSUPDATE_TSIG_KEY=example-key
VCF_API_TOKEN_FILE=/run/secrets/vcf_api_token
SDDC_PASSWORD_FILE=/run/secrets/sddc_password
DNSUPDATE_TSIG_SECRET_FILE=/run/secrets/dns_tsig_secret
# Optional EAB; configure both parts together:
# ACME_EAB_KID=example-kid
# ACME_EAB_HMAC_FILE=/run/secrets/acme_eab_hmac
OUTPUT_DIR=/data

# Comma-delimited, one exact FQDN per role. For a read-only first run, omit
# VCF_ACCEPT_UNVERIFIED_RECOVERY. Before enabling, set ACME_MODE=production.
VCF_RENEW_TARGETS=SDDC_MANAGER=sddc.vcf.example.com,VCENTER=vcenter.vcf.example.com,NSX=nsxt.vcf.example.com,OPERATIONS=ops.vcf.example.com,AUTOMATION=automation.vcf.example.com
# VCF_ACCEPT_UNVERIFIED_RECOVERY=SDDC_MANAGER,VCENTER,NSX,OPERATIONS,AUTOMATION
# VCF_CHECK_INTERVAL_SECONDS=86400
# VCF_HEARTBEAT_MAX_SECONDS=93600
# VCF_SYSLOG_HOST=syslog.example.com
# VCF_SYSLOG_PORT=6514
# VCF_SYSLOG_TRANSPORT=tls
# VCF_SYSLOG_CA_FILE=/run/secrets/syslog_ca

# Optional outbound GitHub version lookup. The scheduler never installs updates.
# UPDATE_CHECK_ENABLED=true
# UPDATE_CHECK_INTERVAL_HOURS=24
# UPDATE_CHECK_TIMEOUT_SECONDS=10
# UPDATE_CHECK_INCLUDE_PRERELEASE=false
